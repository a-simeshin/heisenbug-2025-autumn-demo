{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Person",
  "type": "object",
  "properties": {
    "surname": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "patronymic": {
      "type": "string"
    },
    "birthDate": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "surname",
    "name",
    "patronymic",
    "birthDate"
  ]
}